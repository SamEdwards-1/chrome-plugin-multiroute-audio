{
  "manifest_version": 3,
  "name": "Multiroute Audio",
  "version": "0.1.0",
  "description": "Route audio from individual Chrome tabs to available output devices on your computer.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "tabCapture", "offscreen"],
  "background": { "service_worker": "src/service-worker.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Multiroute Audio", "default_popup": "src/popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } }
}
